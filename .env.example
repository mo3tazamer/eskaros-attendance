# انسخ هذا الملف إلى .env عند الحاجة أو اضبط المتغيرات في لوحة تحكم الاستضافة.
# بدون DATABASE_URL يعمل التطبيق بملفات JSON محليًا (الوضع الافتراضي).

# منفذ الخادم (Render/Railway يوفّرانه تلقائيًا)
PORT=10000
HOST=0.0.0.0

# حساب Supabase Postgres (Session mode — port 5432 + sslmode=require)
# من: لوحة Supabase ← Project Settings ← Database ← Connection string
DATABASE_URL=postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# مكان حفظ البيانات — للوضع المحلي (JSON) فقط؛ مع DATABASE_URL لا يُستخدم
DATA_DIR=/data
BACKUP_DIR=/data/backups

# مدة بقاء تسجيل الدخول (30 يومًا بالمللي ثانية)
SESSION_TTL_MS=2592000000
